ACCESS_PASSWORD=troque-por-um-convite-longo
OWNER_PASSWORD=troque-por-um-codigo-exclusivo-do-dono
AUTH_SALT=troque-por-um-salt-aleatorio
LIVEKIT_API_KEY=CHANGE_ME_KEY
LIVEKIT_API_SECRET=CHANGE_ME_SECRET
# Como quem esta de fora enxerga o LiveKit. Com dominio e TLS, use wss://.
LIVEKIT_PUBLIC_URL=ws://SEU-SERVIDOR:7880

# Busca de GIF. Opcional: sem chave o botao nao aparece no aplicativo e o
# resto continua igual. O servidor e quem fala com o provedor; os clientes
# nunca veem a chave nem o endereco de la.
#
# GIF_PROVIDER aceita giphy (padrao) ou tenor. O Tenor parou de aceitar
# cadastros novos em janeiro de 2026, entao so serve a quem ja tem chave.
# GIF_PROVIDER=giphy
# GIF_API_KEY=

# Chamadas privadas P2P. Opcional: sem nada aqui elas funcionam entre quem se
# enxerga direto (mesma rede, NAT simples). Com TURN, funcionam para todos.
# STUN_URLS=stun:SEU-SERVIDOR:3479
# TURN_URLS=turn:SEU-SERVIDOR:3479?transport=udp,turn:SEU-SERVIDOR:3479?transport=tcp
# TURN_SECRET=troque-por-um-segredo-longo
# IP publico/IP interno da maquina, para o coturn anunciar o endereco certo.
# TURN_EXTERNAL_IP=203.0.113.10/192.168.0.10
