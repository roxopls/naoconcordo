{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "naoconcordo servidor",
  "version": "0.1.1",
  "identifier": "br.com.naoconcordo.painel",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "naoconcordo · servidor",
        "width": 760,
        "height": 640,
        "minWidth": 620,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "binarios/naoconcordo-server.exe"
    ],
    "shortDescription": "Servidor naoncordo para Windows",
    "longDescription": "Sobe um servidor naoconcordo nesta maquina, sem terminal e sem Linux."
  }
}
